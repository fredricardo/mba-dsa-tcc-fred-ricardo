# ============================================================
# .gitignore - Projeto TCC MBA: Análise Dengue São Paulo
# ============================================================

# ============================================================
# PYTHON
# ============================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ============================================================
# JUPYTER NOTEBOOK
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints
*-checkpoint.ipynb
profile_default/
ipython_config.py

# ============================================================
# DADOS (NÃO VERSIONAR ARQUIVOS GRANDES!)
# ============================================================
# Dados brutos e processados
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.json
data/raw/*.geojson
data/raw/*.xml
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.parquet
data/processed/*.feather
data/processed/*.pickle
data/processed/*.pkl
data/

# Arquivos compactados
*.zip
*.gz
*.tar
*.tar.gz
*.rar
*.7z
*.bz2

# Formatos geoespaciais
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.shp.xml

# Formatos diversos de dados
*.tsv
*.dat
*.log
*.sqlite
*.db
*.h5
*.hdf5

# Manter estrutura de pastas vazias
!data/raw/.gitkeep
!data/processed/.gitkeep
!reports/.gitkeep

# ============================================================
# MACHINE LEARNING / MODELOS
# ============================================================
# Modelos treinados
models/*.pkl
models/*.joblib
models/*.h5
models/*.hdf5
models/*.pt
models/*.pth
models/*.onnx
models/*.pb

# MLflow
mlruns/
mlartifacts/

# TensorFlow
*.ckpt
*.ckpt.data*
*.ckpt.index
*.ckpt.meta

# PyTorch
*.pth
*.pt

# Scikit-learn
*.joblib

# Manter pasta de modelos
!models/.gitkeep

# ============================================================
# DATABRICKS
# ============================================================
.databricks/
*.dbc
metastore_db/
derby.log
spark-warehouse/

# ============================================================
# REPORTS E OUTPUTS
# ============================================================
# Relatórios gerados
reports/*.html
reports/*.pdf
reports/*.docx
reports/*.pptx

# Imagens e visualizações geradas
reports/*.png
reports/*.jpg
reports/*.jpeg
reports/*.svg

# Planilhas geradas
reports/*.xlsx
reports/*.csv

# ============================================================
# IDE E EDITORES
# ============================================================
# VSCode
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm
.idea/
.idea/*
*.iml
*.ipr
*.iws
.idea_modules/

# Spyder
.spyproject/
.spyderproject

# Eclipse
.project
.pydevproject
.settings/

# Vim
*~
*.swp
*.swo

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ============================================================
# SISTEMA OPERACIONAL
# ============================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ============================================================
# SEGURANÇA E CREDENCIAIS
# ============================================================
# Variáveis de ambiente
.env
.env.local
.env.*.local
*.env

# Arquivos de configuração com senhas
secrets.yaml
secrets.json
config.local.yaml
credentials.json
*.key
*.pem

# Tokens
*.token
.secrets/

# ============================================================
# DOCUMENTAÇÃO
# ============================================================
# Builds de documentação
docs/_build/
docs/_static/
docs/_templates/
site/
_site/

# Sphinx
docs/build/

# ============================================================
# TEMPORÁRIOS
# ============================================================
*.tmp
*.bak
*.swp
*.swo
*~
*.orig
*.log
local.properties

# ============================================================
# GIT
# ============================================================
*.patch
*.diff

# ============================================================
# OUTROS
# ============================================================
# Node (caso use alguma ferramenta JS)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# R (caso use)
.Rhistory
.RData
.Rproj.user

# Configurações locais
local_config.py
config_local.py
